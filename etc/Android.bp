// TODO(porsche): keep the active A17 configuration bytes while calcite owns
// the install modules. Other products retain the original source defaults.
soong_config_module_type {
    name: "porsche_gnss_config",
    module_type: "prebuilt_etc",
    config_namespace: "porsche",
    bool_variables: ["a17_gnss_configs"],
    properties: ["src"],
}

porsche_gnss_config {

    name: "gps.conf",
    vendor: true,
    soong_config_variables: {
        a17_gnss_configs: {
            src: "//vendor/oneplus/sm8350-common:porsche_gps_conf",
            conditions_default: { src: "gps.conf" },
        },
    },
}

porsche_gnss_config {

    name: "flp.conf",
    vendor: true,
    soong_config_variables: {
        a17_gnss_configs: {
            src: "//vendor/oneplus/sm8350-common:porsche_flp_conf",
            conditions_default: { src: "flp.conf" },
        },
    },
}

porsche_gnss_config {

    name: "gnss_antenna_info.conf",
    vendor: true,
    soong_config_variables: {
        a17_gnss_configs: {
            src: "//vendor/oneplus/sm8350-common:porsche_gnss_antenna_info_conf",
            conditions_default: { src: "gnss_antenna_info.conf" },
        },
    },
}

porsche_gnss_config {
    name: "gnss@2.0-base.policy",
    vendor: true,
    sub_dir: "seccomp_policy",
    soong_config_variables: {
        a17_gnss_configs: {
            src: "//vendor/oneplus/sm8350-common:porsche_gnss_base_policy",
            conditions_default: { src: "seccomp_policy/gnss@2.0-base.policy" },
        },
    },
}

porsche_gnss_config {
    name: "gnss@2.0-xtra-daemon.policy",
    vendor: true,
    sub_dir: "seccomp_policy",
    soong_config_variables: {
        a17_gnss_configs: {
            src: "//vendor/oneplus/sm8350-common:porsche_gnss_xtra_policy",
            conditions_default: { src: "seccomp_policy/gnss@2.0-xtra-daemon.policy" },
        },
    },
}

porsche_gnss_config {
    name: "gnss@2.0-xtwifi-client.policy",
    vendor: true,
    sub_dir: "seccomp_policy",
    soong_config_variables: {
        a17_gnss_configs: {
            src: "//vendor/oneplus/sm8350-common:porsche_gnss_xtwifi_policy",
            conditions_default: { src: "seccomp_policy/gnss@2.0-xtwifi-client.policy" },
        },
    },
}

